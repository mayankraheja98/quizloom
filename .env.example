# Copy to .env and adjust as needed

# Which Ollama model to pull on first start
OLLAMA_MODEL=llama3

# Port the app is accessible on (default: 3000)
APP_PORT=3000

# Set to false only if a corporate proxy breaks TLS (CERTIFICATE_VERIFY_FAILED)
SSL_VERIFY=true

# Random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
